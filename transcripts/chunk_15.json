			},
			"offsets": {
				"from": 0,
				"to": 2000
			},
			"text": " உங்கள் அப்பிட்டாராங்க"
		},
		{
			"timestamps": {
				"from": "00:00:02,000",
				"to": "00:00:06,000"
			},
			"offsets": {
				"from": 2000,
				"to": 6000
			},
			"text": " ரம்பு ஒரேவர் அல்லது இன்னும் எவ்வளவு பெரிய பாதிப்பாடுகிறீர்கள் பாருங்கள்"
		},
		{
			"timestamps": {
				"from": "00:00:06,000",
				"to": "00:00:10,000"
			},
			"offsets": {
				"from": 6000,
				"to": 10000
			},
			"text": " அவன் நியாயமா, அனியாயமா என்று தெரியவில்லை நாங்கள்"
		},
		{
			"timestamps": {
				"from": "00:00:10,000",
				"to": "00:00:15,000"
			},
			"offsets": {
				"from": 10000,
				"to": 15000
			},
			"text": " அரம் தேஷங்களில் யாருக்கு முன்னால இருக்கும் பிரிஸினினிட்டு"
		},
		{
			"timestamps": {
				"from": "00:00:15,000",
				"to": "00:00:21,000"
			},
			"offsets": {
				"from": 15000,
				"to": 21000
			},
			"text": " ஏற்படுத்தி வைச்ச அமரிக்காவுடைய ஏற்பேஸ் அங்கிருந்து இரானுக்கு பாம் போடுறான்"
		},
		{
			"timestamps": {
				"from": "00:00:21,000",
				"to": "00:00:27,000"
			},
			"offsets": {
				"from": 21000,
				"to": 27000
			},
			"text": " இரான் திருப்பி எடிக்கது அரம் தேஷத்து, அமரிக்கா மேல் அவனால அவ்வளவு"
		},
		{
			"timestamps": {
				"from": "00:00:27,000",
				"to": "00:00:32,000"
			},
			"offsets": {
				"from": 27000,
				"to": 32000
			},
			"text": " ரெய்னி மிசானி இல்லை அரம் தேஷத்து பாரிக்கிறேன்"
		},
		{
			"timestamps": {
				"from": "00:00:32,000",
				"to": "00:00:37,000"
			},
			"offsets": {
				"from": 32000,
				"to": 37000
			},
			"text": " இவன் என்ன பண்ணா, அரம் தேஷம் துபை என்ன பண்ணித்து"
		},
		{
			"timestamps": {
				"from": "00:00:37,000",
				"to": "00:00:48,000"
			},
			"offsets": {
				"from": 37000,
				"to": 48000
			},
			"text": " பணத்துக்காக தன்னே நாட்டு ஓயல் மேலையும் தன்னே நாட்டுயும் அமரிக்காவுடைய குவித்தான் பணத்துக்காக"
		},
		{
			"timestamps": {
				"from": "00:00:48,000",
				"to": "00:00:54,000"
			},
			"offsets": {
				"from": 48000,
				"to": 54000
			},
			"text": " ஒசம்ம பெண்ணாடனே, அமரிக்கன் கொண்டரைட்டர், ஆனால அரமிக்"
		},
		{
			"timestamps": {
				"from": "00:00:54,000",
				"to": "00:01:03,000"
			},
			"offsets": {
				"from": 54000,
				"to": 63000
			},
			"text": " இது நம்முடைய அறிவால புரிந்துகொள்ள விஷயம் இல்லை"
		},
		{
			"timestamps": {
				"from": "00:01:03,000",
				"to": "00:01:11,000"
			},
			"offsets": {
				"from": 63000,
				"to": 71000
			},
			"text": " யார்? ஏன் இவன் பாதிக்கப்பட்டும்? ரோடில் போடுவேன், துப்பாக்கிச் சூட்டில்"
		},
		{
			"timestamps": {
				"from": "00:01:11,000",
				"to": "00:01:17,000"
			},
			"offsets": {
				"from": 71000,
				"to": 77000
			},
			"text": " நேற்று நம்ம பையா ஒத்தன், நாக்பூரில் யோட்டியா போராட்டதுக்கு வேண்டாம்"
		},
		{
			"timestamps": {
				"from": "00:01:17,000",
				"to": "00:01:21,000"
			},
			"offsets": {
				"from": 77000,
				"to": 81000
			},
			"text": " அந்தக் கட்டத்தை இடிக்கும்போது, முகாயின் சிங்க் வந்து"
		},
		{
			"timestamps": {
				"from": "00:01:21,000",
				"to": "00:01:33,000"
			},
			"offsets": {
				"from": 81000,
				"to": 93000
			},
			"text": " நான் ரப்பர் புருண்டு, குலிஸ் துட்டுது, இப்போது அவனுக்கு 82லிருந்து எத்தனை வருடங்கள் ஆன்று, இது 35 வருடங்கள் ஆன்று"
		},
		{
			"timestamps": {
				"from": "00:01:33,000",
				"to": "00:01:40,000"
			},
			"offsets": {
				"from": 93000,
				"to": 100000
			},
			"text": " அவனுடைய ஒரு கண்ணு குருடா இருக்கிறது, நன்றாக மிகவும் பாவர்ப்புல் ஆளு"
		},
		{
			"timestamps": {
				"from": "00:01:40,000",
				"to": "00:01:43,000"
			},
			"offsets": {
				"from": 100000,
				"to": 103000
			},
			"text": " அவன் பொல்லுட்டேஷனா வந்திருந்தால் என்னிடம் இருக்கலாம்"
		},
		{
			"timestamps": {
				"from": "00:01:43,000",
				"to": "00:01:51,000"
			},
			"offsets": {
				"from": 103000,
				"to": 111000
			},
			"text": " தேவெந்தன் பண்ணவீசுவின் தொகுதையில் சீப்பினேஸ்டாகக்கூட இருக்கலாம், முடிந்துவிட்டது எல்லாரும் பெரியும்"
		},
		{
			"timestamps": {
				"from": "00:01:51,000",
				"to": "00:01:55,000"
			},
			"offsets": {
				"from": 111000,
				"to": 115000
			},
			"text": " இப்போது இதை என்ன செய்தான், கூட்டத்தில் இருந்தான்"
		},
		{
			"timestamps": {
				"from": "00:01:55,000",
				"to": "00:02:15,000"
			},
			"offsets": {
				"from": 115000,
				"to": 135000
			},
			"text": " தேவெந்தன் பண்ணவீசுவின் தொகுதாகக்கூட்டது எல்லாரும் பெரியும்"
		},
		{
